#, python-format
msgctxt "model:ir.message,text:msg_clamd_malware"
msgid "The antivirus has detected a problem with this file: %(response)s"
msgstr "A víruskereső problémát észlelt ezzel a fájllal: %(response)s"

#, python-format
msgctxt "model:ir.message,text:msg_invalid_configuration"
msgid "The S3 configuration is invalid: %(error)s"
msgstr "Az S3 beállítása érvénytelen: %(error)s"

msgctxt "model:ir.message,text:msg_fernet_key_required"
msgid ""
"You must configure cryptography/fernet_key before saving files in the S3 "
"filestore."
msgstr ""
"Az S3-fájltárba való mentés előtt be kell állítania a "
"cryptography/fernet_key értékét."

msgctxt "model:ir.message,text:msg_invalid_clamd_configuration"
msgid "The s3/clamd setting must be a socket path or host:port."
msgstr ""
"Az s3/clamd beállításnak foglalatelérési útnak vagy host:port értéknek kell "
"lennie."

msgctxt "model:ir.message,text:msg_clamd_no_response"
msgid "ClamAV did not return a response."
msgstr "A ClamAV nem adott választ."

msgctxt "model:ir.message,text:msg_antivirus"
msgid "Antivirus"
msgstr "Víruskereső"

msgctxt "model:ir.message,text:msg_clamd_unavailable"
msgid "The antivirus could not process the file."
msgstr "A víruskereső nem tudta feldolgozni a fájlt."

#, python-format
msgctxt "model:ir.message,text:msg_clamd_invalid_version_response"
msgid "Unexpected ClamAV VERSION response: %(response)s"
msgstr "Váratlan ClamAV VERSION-válasz: %(response)s"

#, python-format
msgctxt "model:ir.message,text:msg_clamd_invalid_scan_response"
msgid "Unexpected ClamAV scan response: %(response)s"
msgstr "Váratlan ClamAV-vizsgálati válasz: %(response)s"

msgctxt "model:res.group,name:group_clamav_malware_warning"
msgid "Antivirus Malware Warning"
msgstr "Víruskereső kártevő-figyelmeztetése"

msgctxt "selection:ir.cron,method:"
msgid "S3 - Synchronize Cache"
msgstr "S3 – Gyorsítótár szinkronizálása"
